const function ResolveStateActions(actions: ActionMap)
	const states = Info.states :: { [number]: StateInfo }
	const numstates = Info.NUMSTATES :: number

	for index = 0, numstates - 1 do
		const state = states[index]
		const actionName = state.actionName

		if actionName == false then
			state.action = false
		else
			state.action = actions[actionName] or false
		end
	end
end

const function ResolveMobjSounds(sounds: ActionMap)
	const mobjinfo = Info.mobjinfo :: { [number]: MobjInfo }
	const nummobjtypes = Info.NUMMOBJTYPES :: number

	for index = 0, nummobjtypes - 1 do
		const info = mobjinfo[index]
		const seesoundName = info.seesoundName
		const attacksoundName = info.attacksoundName
		const painsoundName = info.painsoundName
		const deathsoundName = info.deathsoundName
		const activesoundName = info.activesoundName

		info.seesound = if seesoundName == false then false else sounds[seesoundName] or false
		info.attacksound = if attacksoundName == false then false else sounds[attacksoundName] or false
		info.painsound = if painsoundName == false then false else sounds[painsoundName] or false
		info.deathsound = if deathsoundName == false then false else sounds[deathsoundName] or false
		info.activesound = if activesoundName == false then false else sounds[activesoundName] or false
	end
end

Info.ResolveStateActions = ResolveStateActions
Info.ResolveMobjSounds = ResolveMobjSounds

return Info
